generator client {
  provider = "prisma-client"
  output   = "../prisma/generated/client"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

enum SellerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  UPCOMING
  ACTIVE
  ENDED
  SOLD
  REJECTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  REJECTED
}

enum CreditPurchaseStatus {
  PENDING_PAYMENT
  WAITING_VERIFICATION
  COMPLETED
  REJECTED
}

enum OrderStatus {
  PENDING_CONTACT_FEE
  WAITING_VERIFICATION
  CONTACT_FEE_PAID
  COMPLETED
  REJECTED
  CANCELLED
}

enum ListingMode {
  AUCTION
  RETAIL
  BOTH
}

enum SellerPlan {
  FREE
  BASIC_499
  PRO_999
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum RetailOrderStatus {
  PENDING_PAYMENT
  PAYMENT_VERIFIED
  ADDRESS_RELEASED
  PACKED
  SHIPPED
  DELIVERED
  BUYER_CONFIRMED
  COMPLETED
  CANCELLED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                  String        @id @default(cuid())
  email               String        @unique
  emailVerified       DateTime?
  password            String?
  name                String?
  image               String?
  role                UserRole      @default(CUSTOMER)
  sellerStatus        SellerStatus?
  sellerNote          String? // admin note on rejection
  isBanned            Boolean       @default(false)
  phone               String?
  whatsappNumber      String?
  listingCredits      Int           @default(0)
  freeListingsGranted Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  accounts           Account[]
  sessions           Session[]
  listings           Listing[]
  bids               Bid[]
  buyerOrders        Order[]          @relation("BuyerOrders")
  sellerOrders       Order[]          @relation("SellerOrders")
  buyerRetailOrders  RetailOrder[]    @relation("BuyerRetailOrders")
  sellerRetailOrders RetailOrder[]    @relation("SellerRetailOrders")
  subscriptions      Subscription[]
  addresses          Address[]
  payouts            Payout[]
  supportTickets     SupportTicket[]
  savedItems         SavedItem[]
  upcomingVotes      UpcomingVote[]
  sellerProfile      SellerProfile?
  creditPurchases    CreditPurchase[]
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  country   String  @default("India")
  isDefault Boolean @default(false)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  emoji     String
  color     String
  textColor String
  createdAt DateTime  @default(now())
  listings  Listing[]
}

model Listing {
  id             String            @id @default(cuid())
  title          String
  description    String
  categoryId     String
  sellerId       String
  images         String[]
  listingMode    ListingMode       @default(AUCTION)
  startingBid    Int
  buyNowPrice    Int?
  currentBid     Int?
  bidIncrement   Int               @default(50)
  reservePrice   Int?
  size           String?
  condition      ListingCondition?
  status         ListingStatus     @default(DRAFT)
  featured       Boolean           @default(false)
  featuredUntil  DateTime?
  verified       Boolean           @default(false)
  hot            Boolean           @default(false)
  endsAt         DateTime
  startsAt       DateTime?
  durationHours  Int               @default(24)
  upcomingIntent Boolean           @default(false)
  views          Int               @default(0)
  watchers       Int               @default(0)
  bidCount       Int               @default(0)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id])
  seller         User            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  bids           Bid[]
  order          Order?
  retailOrder    RetailOrder?
  savedItems     SavedItem[]
  featureCharges FeatureCharge[]
  upcomingVotes  UpcomingVote[]

  @@index([status])
  @@index([categoryId])
  @@index([sellerId])
  @@index([size])
  @@index([listingMode])
}

enum ListingCondition {
  NEW
  LIKE_NEW
  EXCELLENT
  GOOD
  FAIR
}

model Bid {
  id        String   @id @default(cuid())
  amount    Int
  listingId String
  bidderId  String
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidder  User    @relation(fields: [bidderId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@index([bidderId])
}

model SavedItem {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId])
}

model UpcomingVote {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([listingId])
  @@index([userId])
}

model Order {
  id                     String      @id @default(cuid())
  listingId              String      @unique
  buyerId                String
  sellerId               String
  finalPrice             Int
  platformFee            Int         @default(69)
  status                 OrderStatus @default(PENDING_CONTACT_FEE)
  shippingAddress        Json?
  razorpayOrderId        String?
  paymentId              String?
  buyerPhone             String?
  buyerAgreementAccepted Boolean     @default(false)
  paidVia                String?
  proofUrl               String?
  contactFeeConfirmed    Boolean     @default(false)
  paymentDeadline        DateTime?
  itemPaymentDeadline    DateTime?
  sellerMarkedReadyAt    DateTime?
  buyerConfirmedAt       DateTime?
  sellerOrderDetails     Json?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  listing Listing @relation(fields: [listingId], references: [id])
  buyer   User    @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller  User    @relation("SellerOrders", fields: [sellerId], references: [id])
}

model FeatureCharge {
  id        String   @id @default(cuid())
  listingId String
  amount    Int
  days      Int
  note      String?
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
}

model Payout {
  id        String       @id @default(cuid())
  sellerId  String
  amount    Int
  status    PayoutStatus @default(PENDING)
  method    String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  seller User @relation(fields: [sellerId], references: [id])
}

model SupportTicket {
  id        String   @id @default(cuid())
  userId    String
  subject   String
  message   String   @db.Text
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model SellerProfile {
  id                String     @id @default(cuid())
  userId            String     @unique
  storeName         String
  storeDescription  String?
  location          String?
  whatsappNumber    String
  returnPolicy      String?
  plan              SellerPlan @default(FREE)
  planExpiresAt     DateTime?
  listingsUsed      Int        @default(0)
  storeSlug         String?    @unique
  storeLogo         String?
  instagramUrl      String?
  upiId             String?
  acceptedAgreement Boolean    @default(false)
  acceptedAt        DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RetailOrder {
  id               String            @id @default(cuid())
  listingId        String            @unique
  buyerId          String
  sellerId         String
finalPrice         Int
  connectionFee      Int               @default(39)
  status             RetailOrderStatus @default(PENDING_PAYMENT)
  paymentMethod      String?
  paymentProofUrl    String?
  buyerName          String?
  adminVerifiedAt    DateTime?
  paymentDeadline  DateTime?
  address          Json?
  buyerPhone       String?
  trackingNumber   String?
  trackingUrl      String?
  shippedAt        DateTime?
  deliveredAt      DateTime?
  buyerConfirmedAt DateTime?
  completedAt      DateTime?
  commission       Int?
  sellerPayout     Int?
  payoutAt         DateTime?
  adminNotes       String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  listing Listing @relation(fields: [listingId], references: [id])
  buyer   User    @relation("BuyerRetailOrders", fields: [buyerId], references: [id])
  seller  User    @relation("SellerRetailOrders", fields: [sellerId], references: [id])

  @@index([buyerId])
  @@index([sellerId])
  @@index([status])
}

model Subscription {
  id        String             @id @default(cuid())
  sellerId  String
  plan      SellerPlan
  amount    Int
  status    SubscriptionStatus @default(ACTIVE)
  startsAt  DateTime           @default(now())
  endsAt    DateTime
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  seller User @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId])
  @@index([status])
}

model CreditPurchase {
  id        String               @id @default(cuid())
  userId    String
  package   String
  amount    Int
  credits   Int
  paidVia   String?
  status    CreditPurchaseStatus @default(WAITING_VERIFICATION)
  proofUrl  String?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}
